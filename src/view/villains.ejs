<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vilões Cadastrados</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      }
    body {
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      background: #14161d;
      color: #e8e8ec;
      padding: 32px 16px;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    header { margin-bottom: 8px; }
    header h1 { font-size: 1.9rem; color: #ff4d4d; letter-spacing: .5px; }
    header p { color: #9aa0aa; margin-top: 6px; }
    table {
      width: 100%;
      border-collapse: collapse;
      background: #1c1f29;
      border-radius: 10px;
      overflow: hidden;
    }
    thead th {
      text-align: left;
      padding: 14px 16px;
      background: #232734;
      color: #ff8080;
      font-size: .85rem;
      text-transform: uppercase;
      letter-spacing: .6px;
    }
    tbody td { padding: 14px 16px; border-top: 1px solid #2c303c; }
    tbody tr:hover { background: #222633; }
    .tag {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(255,77,77,.15);
      color: #ff8080;
      font-size: .8rem;
    }
    .empty { text-align: center; padding: 40px; color: #9aa0aa; }
    .count { margin-top: 14px; color: #9aa0aa; font-size: .9rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Vilões Cadastrados</h1>
      <p>Listagem de vilões registrados no banco de dados.</p>
    </header>

    <% if (villains && villains.length) { %>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Poderes</th>
          <th>Categoria</th>
          <th>Idade</th>
        </tr>
      </thead>
      <tbody>
        <% villains.forEach(function (villain) { %>
        <tr>
          <td><%= villain.id %></td>
          <td><%= villain.nome %></td>
          <td><%= villain.poderes %></td>
          <td><span class="tag"><%= villain.categoria %></span></td>
          <td><%= villain.idade %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <p class="count">Total: <%= villains.length %> villain(s).</p>
    <% } else { %>
    <div class="empty">Nenhum villain cadastrado.</div>
    <% } %>
  </div>
</body>
</html>
